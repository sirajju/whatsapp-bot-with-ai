## wabot config

# Command prefix recognised in chats
PREFIX=!

# Comma-separated list of JIDs (owner numbers) allowed to use admin commands
# Format: 919xxxxxxxxx (no +, no @s.whatsapp.net)
OWNERS=

# Login mode: pairing (phone number required) or qr
LOGIN_MODE=pairing
PAIR_PHONE=

# Storage
SESSION_DIR=./session
LOG_LEVEL=info

# AI providers (all optional; leave blank to disable)
# At most one is used per !ai call, in this priority order: OLLAMA > GROQ > ANTHROPIC > OPENAI > GEMINI
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Group behaviour
RESPOND_IN_GROUPS=true
GROUP_TRIGGER_MENTION_ONLY=false
