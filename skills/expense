#!/usr/bin/env python3
# desc: shared expense tracker — expense items + optional payer, per-chat
"""
Per-chat shared expense tracker.

Called via !expense (preferred) or !skill expense.
State lives in session/state/expense.db, a sqlite DB separate from the Go store.

Model (v2)
----------
Two separate rosters:

  Split participants (members)
      Explicit list of people sharing costs. Set with `members`.
      The per-person share is computed as pool_total / len(members),
      or pool_total / split_N if you've set a fixed N via `split`.

  Expenses
      Each expense is an item: a name (e.g. "veg", "pizza") and an amount.
      Optionally a "paid_by" — one of the members who covered it. If paid_by
      is empty, nobody's been credited for it yet.

  Balance per member M:
      net(M) = paid_by_total(M) - pool_total / N
             + received_direct(M) - given_direct(M)

      Positive → group owes M.  Negative → M owes the group.

Syntax
------
  add  <name> <amount> [(payer)] [note…]     shared expense, optional payer
  pay  <from> <amount> <to>                   direct settlement, 1-to-1
  settle <id> <payer>                         mark a credit entry as paid by
  credit | due | monthend                    list all unpaid (credit) entries
  members <name> [name...]                    replace members list
  members +<name>                             add a single member
  members -<name>                             remove a single member
  split <N>                                   set group size (0 = len(members))
  total | sum | balance                       per-person net
  list [N] | ls                               last N entries
  del <id> | rm <id>                          remove an entry
  clear | reset                               wipe this chat
  who                                         members + participants seen

Credit
------
  An expense with no payer is on CREDIT — the group collectively owes
  that amount (shop tab, month-end bill, etc). Balance math still splits
  the share among members; `settle` moves the row from credit to paid.

Shortcuts (no subcommand):
  "<name> <amount>"                           shared add, no payer
  "<name> <amount> (<payer>)"                 shared add with payer
  "<name> <amount> words…"                    shared add with a note
"""
from __future__ import annotations
import os
import re
import sqlite3
import sys
import textwrap
from pathlib import Path

CHAT = os.environ.get("WABOT_CHAT", "default")

PROJECT_DIR = Path(os.environ.get(
    "WABOT_PROJECT_DIR",
    Path(__file__).resolve().parent.parent,
))
DB_PATH = PROJECT_DIR / "session" / "state" / "expense.db"
DB_PATH.parent.mkdir(parents=True, exist_ok=True)

conn = sqlite3.connect(DB_PATH)
conn.execute("PRAGMA busy_timeout = 5000")
conn.executescript("""
CREATE TABLE IF NOT EXISTS expense_group (
  chat_jid   TEXT PRIMARY KEY,
  split_n    INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS expense (
  id         INTEGER PRIMARY KEY AUTOINCREMENT,
  chat_jid   TEXT NOT NULL,
  payer      TEXT NOT NULL,
  amount     REAL NOT NULL,
  recipient  TEXT,
  note       TEXT,
  created_at INTEGER NOT NULL DEFAULT (strftime('%s','now'))
);
CREATE INDEX IF NOT EXISTS expense_chat ON expense(chat_jid, created_at);
""")


# ---------- schema migration v1 → v2 ----------

def _cols(table: str) -> set[str]:
    return {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}


def migrate():
    if "name" not in _cols("expense"):
        # v1 had `payer` holding what we now call `name`. Rename it, then
        # add the real `paid_by`. Promote single-word notes into paid_by
        # since users were already using the note column that way.
        conn.execute("ALTER TABLE expense RENAME COLUMN payer TO name")
        conn.execute("ALTER TABLE expense ADD COLUMN paid_by TEXT")
        conn.execute("""
            UPDATE expense
            SET paid_by = note, note = NULL
            WHERE paid_by IS NULL
              AND note IS NOT NULL
              AND note NOT LIKE '% %'
              AND LENGTH(note) < 32
              AND note GLOB '[a-zA-Z_]*'
        """)
    if "members" not in _cols("expense_group"):
        conn.execute("ALTER TABLE expense_group ADD COLUMN members TEXT NOT NULL DEFAULT ''")
    conn.commit()


migrate()


# ---------- helpers ----------

NAME_RE = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_.-]*$")


def normalize_name(s: str) -> str:
    return s.strip().lower()


def parse_amount(s: str):
    try:
        return float(s.replace(",", "").replace("_", ""))
    except ValueError:
        return None


def strip_parens(s: str) -> str:
    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
        return s[1:-1]
    return s


def _group_row():
    return conn.execute(
        "SELECT split_n, members FROM expense_group WHERE chat_jid=?", (CHAT,)
    ).fetchone()


def get_split_n() -> int:
    row = _group_row()
    return int(row[0]) if row else 0


def get_members() -> list[str]:
    row = _group_row()
    if not row or not row[1]:
        return []
    return [m for m in row[1].split(",") if m]


def set_split_n(n: int):
    conn.execute(
        "INSERT INTO expense_group(chat_jid, split_n, members) VALUES(?,?,?) "
        "ON CONFLICT(chat_jid) DO UPDATE SET split_n=excluded.split_n",
        (CHAT, n, ""),
    )
    conn.commit()


def set_members(members: list[str]):
    members = sorted({normalize_name(m) for m in members if m.strip()})
    for m in members:
        if not NAME_RE.match(m):
            raise ValueError(f"bad name: {m}")
    csv = ",".join(members)
    conn.execute(
        "INSERT INTO expense_group(chat_jid, split_n, members) VALUES(?,?,?) "
        "ON CONFLICT(chat_jid) DO UPDATE SET members=excluded.members",
        (CHAT, 0, csv),
    )
    conn.commit()


def seen_participants() -> list[str]:
    """Names that have appeared as paid_by/recipient on any expense."""
    rows = conn.execute(
        """
        SELECT paid_by FROM expense WHERE chat_jid=? AND paid_by IS NOT NULL
        UNION
        SELECT recipient FROM expense WHERE chat_jid=? AND recipient IS NOT NULL
        """,
        (CHAT, CHAT),
    ).fetchall()
    return sorted({r[0] for r in rows if r[0]})


def effective_n() -> int:
    n = get_split_n()
    if n > 0:
        return n
    m = get_members()
    if m:
        return len(m)
    return max(len(seen_participants()), 1)


def record(name, amount, paid_by=None, recipient=None, note=None):
    conn.execute(
        "INSERT INTO expense(chat_jid, name, amount, paid_by, recipient, note) "
        "VALUES(?,?,?,?,?,?)",
        (CHAT, name, float(amount), paid_by, recipient, note),
    )
    conn.commit()


def fmt_amt(x: float) -> str:
    s = f"{x:.2f}"
    return s[:-3] if s.endswith(".00") else s


# ---------- subcommands ----------

def usage() -> str:
    return textwrap.dedent("""\
        💰 *Expense tracker*

        *add* <name> <amount> [(payer)] [note]   shared expense (unpaid = credit)
        *settle* <id> <payer>                    mark a credit entry as paid by
        *credit* | *due* | *monthend*            list unpaid (credit) entries
        *pay* <from> <amount> <to>                direct settlement
        *members* <name> [name...]                set participants
        *members* +<name> | -<name>               add/remove one
        *split* <N>                                fixed group size (0 = members count)
        *total* | *sum* | *balance*                per-person net balance
        *list* [N] | *ls*                          last N entries
        *del* <id> | *rm* <id>                     remove entry
        *clear* | *reset*                          wipe this chat
        *who*                                       members + anyone seen

        Credit: an expense with no payer is on CREDIT (group tab, pay later).
        Use *settle* when someone pays it. Use *credit* to see what's open.

        Shortcuts (no subcommand):
          `<name> <amount>`                        shared add, on credit
          `<name> <amount> (<payer>)`              shared add, payer known
          `<name> <amount> words…`                 shared add with a note""")


def cmd_add(args):
    if len(args) < 2:
        return "usage: add <name> <amount> [(payer)] [note]"
    name = normalize_name(args[0])
    if not NAME_RE.match(name):
        return f"bad name: {args[0]}"
    amount = parse_amount(args[1])
    if amount is None or amount <= 0:
        return f"bad amount: {args[1]}"

    paid_by = None
    rest = args[2:]
    # Optional leading "(payer)"
    if rest and rest[0].startswith("(") and rest[0].endswith(")"):
        pb = normalize_name(strip_parens(rest[0]))
        if not NAME_RE.match(pb):
            return f"bad payer: {rest[0]}"
        paid_by = pb
        rest = rest[1:]
    note = " ".join(rest).strip() or None

    record(name, amount, paid_by=paid_by, note=note)
    bits = [f"*{name}* {fmt_amt(amount)}"]
    if paid_by:
        bits.append(f"paid by *{paid_by}*")
    if note:
        bits.append(f"_{note}_")
    return "✅ added — " + " · ".join(bits)


def cmd_pay(args):
    if len(args) < 3:
        return "usage: pay <from> <amount> <to>"
    src = normalize_name(args[0])
    amount = parse_amount(args[1])
    dst = normalize_name(strip_parens(args[2]))
    if not NAME_RE.match(src):
        return f"bad name: {args[0]}"
    if amount is None or amount <= 0:
        return f"bad amount: {args[1]}"
    if not NAME_RE.match(dst):
        return f"bad recipient: {args[2]}"
    if src == dst:
        return "payer and recipient are the same person"
    record("(settlement)", amount, paid_by=src, recipient=dst)
    return f"✅ {src} → {dst}: {fmt_amt(amount)}"


def cmd_members(args):
    if not args:
        m = get_members()
        s = seen_participants()
        extra = sorted(set(s) - set(m))
        lines = [f"members ({len(m)}): " + (", ".join(m) if m else "(none set)")]
        if extra:
            lines.append(f"also seen in history: {', '.join(extra)}")
        lines.append(f"effective split: {effective_n()}")
        return "\n".join(lines)

    # +foo / -foo edits
    if args[0].startswith("+") or args[0].startswith("-"):
        current = set(get_members())
        for a in args:
            if a.startswith("+"):
                nm = normalize_name(a[1:])
                if NAME_RE.match(nm):
                    current.add(nm)
            elif a.startswith("-"):
                nm = normalize_name(a[1:])
                current.discard(nm)
        try:
            set_members(sorted(current))
        except ValueError as e:
            return str(e)
        return f"members: {', '.join(sorted(current)) or '(none)'}"

    # full replacement
    try:
        set_members(args)
    except ValueError as e:
        return str(e)
    m = get_members()
    return f"members: {', '.join(m)}"


def cmd_split(args):
    if not args:
        n = get_split_n()
        m = get_members()
        return (
            f"split: {'auto' if n == 0 else n}  "
            f"(members: {len(m)}, effective: {effective_n()})"
        )
    try:
        n = int(args[0])
    except ValueError:
        return "usage: split <N>  (0 = auto by members)"
    if n < 0:
        return "N must be ≥ 0"
    set_split_n(n)
    return f"✅ split set to {'auto' if n == 0 else n}"


def cmd_total(_args=None):
    rows = conn.execute(
        "SELECT name, amount, paid_by, recipient FROM expense WHERE chat_jid=?",
        (CHAT,),
    ).fetchall()
    if not rows:
        return "no expenses yet. Try: add veg 300 (samad)"

    n = effective_n()
    members = get_members()
    paid, given, received = {}, {}, {}
    shared_total = 0.0
    orphans_total = 0.0  # pool amount with no paid_by assigned
    for name, amount, paid_by, recipient in rows:
        if recipient:
            given[paid_by] = given.get(paid_by, 0.0) + amount
            received[recipient] = received.get(recipient, 0.0) + amount
        else:
            shared_total += amount
            if paid_by:
                paid[paid_by] = paid.get(paid_by, 0.0) + amount
            else:
                orphans_total += amount

    universe = sorted(
        set(members) | set(paid) | set(given) | set(received) | set(seen_participants())
    )
    share = shared_total / n if n else 0.0

    lines = [
        "💰 *Expense balances*",
        f"shared pool: {fmt_amt(shared_total)}   split by: {n}   "
        f"per-person share: {fmt_amt(share)}",
    ]
    if orphans_total > 0:
        lines.append(
            f"💳 {fmt_amt(orphans_total)} on credit (unpaid). "
            "Use `credit` to see which, `settle <id> <payer>` to assign."
        )
    lines.append("")
    for name in universe:
        p = paid.get(name, 0.0)
        g = given.get(name, 0.0)
        r = received.get(name, 0.0)
        net = p - share + r - g
        if net > 0.005:
            tag = "📈 is owed"
        elif net < -0.005:
            tag = "📉 owes   "
        else:
            tag = "✅ settled"
        extras = []
        if r:
            extras.append(f"in {fmt_amt(r)}")
        if g:
            extras.append(f"out {fmt_amt(g)}")
        extra_s = ", " + ", ".join(extras) if extras else ""
        lines.append(
            f"{tag}  *{name}*  → net {net:+.2f}   "
            f"(paid {fmt_amt(p)}, share {fmt_amt(share)}{extra_s})"
        )
    return "\n".join(lines)


def cmd_list(args):
    n = 10
    if args:
        try:
            n = max(1, min(50, int(args[0])))
        except ValueError:
            pass
    rows = conn.execute(
        "SELECT id, name, amount, paid_by, recipient, note "
        "FROM expense WHERE chat_jid=? ORDER BY created_at DESC LIMIT ?",
        (CHAT, n),
    ).fetchall()
    if not rows:
        return "no expenses yet."
    out = [f"last {len(rows)}:"]
    for id_, name, amount, paid_by, recipient, note in rows:
        line = f"  #{id_}  {name} {fmt_amt(amount)}"
        if recipient:
            line += f" ({paid_by}→{recipient})"
        elif paid_by:
            line += f" ({paid_by})"
        if note:
            line += f"  _{note}_"
        out.append(line)
    return "\n".join(out)


def cmd_del(args):
    if not args:
        return "usage: del <id>"
    try:
        id_ = int(args[0])
    except ValueError:
        return f"bad id: {args[0]}"
    cur = conn.execute(
        "DELETE FROM expense WHERE id=? AND chat_jid=?", (id_, CHAT)
    )
    conn.commit()
    return f"deleted #{id_}" if cur.rowcount else f"no entry #{id_}"


def cmd_settle(args):
    """Mark one credit entry (paid_by IS NULL) as paid by <payer>."""
    if len(args) < 2:
        return "usage: settle <id> <payer>"
    try:
        id_ = int(args[0])
    except ValueError:
        return f"bad id: {args[0]}"
    payer = normalize_name(strip_parens(args[1]))
    if not NAME_RE.match(payer):
        return f"bad payer: {args[1]}"

    row = conn.execute(
        "SELECT name, amount, paid_by, recipient FROM expense "
        "WHERE id=? AND chat_jid=?",
        (id_, CHAT),
    ).fetchone()
    if not row:
        return f"no entry #{id_}"
    name, amount, existing_payer, recipient = row
    if recipient:
        return f"#{id_} is a direct payment, not a credit entry"
    if existing_payer:
        return f"#{id_} already settled: paid by *{existing_payer}*"

    conn.execute(
        "UPDATE expense SET paid_by=? WHERE id=? AND chat_jid=?",
        (payer, id_, CHAT),
    )
    conn.commit()
    return f"✅ #{id_} *{name}* {fmt_amt(amount)} — now paid by *{payer}*"


def cmd_credit(_args=None):
    """List every credit (unpaid) expense: paid_by IS NULL, no recipient."""
    rows = conn.execute(
        "SELECT id, name, amount, note, created_at "
        "FROM expense WHERE chat_jid=? AND paid_by IS NULL AND recipient IS NULL "
        "ORDER BY created_at",
        (CHAT,),
    ).fetchall()
    if not rows:
        return "no credit entries — all expenses are paid."
    import datetime as _dt
    lines = [f"💳 *Credit / unpaid* ({len(rows)})"]
    total = 0.0
    for id_, name, amount, note, ts in rows:
        when = _dt.datetime.fromtimestamp(ts).strftime("%d %b")
        line = f"  #{id_}  {name} {fmt_amt(amount)}  _{when}_"
        if note:
            line += f"  — {note}"
        lines.append(line)
        total += amount
    lines.append("")
    lines.append(f"total open: *{fmt_amt(total)}*")
    lines.append(f"settle with: `settle <id> <payer>`")
    return "\n".join(lines)


def cmd_clear(_args):
    cur = conn.execute("DELETE FROM expense WHERE chat_jid=?", (CHAT,))
    conn.execute("DELETE FROM expense_group WHERE chat_jid=?", (CHAT,))
    conn.commit()
    return f"wiped {cur.rowcount} entries for this chat"


def cmd_who(_args=None):
    m = get_members()
    s = seen_participants()
    lines = [f"members ({len(m)}): " + (", ".join(m) if m else "(none set)")]
    extra = sorted(set(s) - set(m))
    if extra:
        lines.append(f"also seen: {', '.join(extra)}")
    return "\n".join(lines)


ROUTES = {
    "add": cmd_add,
    "pay": cmd_pay,
    "settle": cmd_settle,
    "credit": cmd_credit,
    "due": cmd_credit,
    "monthend": cmd_credit,
    "open": cmd_credit,
    "members": cmd_members,
    "member": cmd_members,
    "split": cmd_split,
    "total": cmd_total,
    "sum": cmd_total,
    "balance": cmd_total,
    "list": cmd_list,
    "ls": cmd_list,
    "del": cmd_del,
    "rm": cmd_del,
    "clear": cmd_clear,
    "reset": cmd_clear,
    "who": cmd_who,
    "help": lambda _: usage(),
    "?": lambda _: usage(),
}


def main():
    args = sys.argv[1:]
    if not args:
        print(usage())
        return

    # Shortcut: "<name> <amount> ..." → add
    if (
        len(args) >= 2
        and args[0].lower() not in ROUTES
        and parse_amount(args[1]) is not None
    ):
        print(cmd_add(args))
        return

    cmd = args[0].lower()
    fn = ROUTES.get(cmd)
    if not fn:
        print(f"unknown subcommand: *{cmd}*\n\n{usage()}")
        return
    print(fn(args[1:]))


if __name__ == "__main__":
    main()
