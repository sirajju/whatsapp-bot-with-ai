## wabot config template — copy to .env and fill in.

# Command prefix recognised in chats
PREFIX=!

# Comma-separated owner JIDs (digits only, country code included, no + or @s.whatsapp.net)
OWNERS=

# Login: pairing (headless, recommended) or qr
LOGIN_MODE=pairing
PAIR_PHONE=

# Storage & Logging
SESSION_DIR=./session
LOG_LEVEL=info

# Group behaviour
RESPOND_IN_GROUPS=true
GROUP_TRIGGER_MENTION_ONLY=false

# Startup notification: sends "🟢 wabot up on <host>" DM to first owner on connect
STARTUP_NOTIFY=on

# ---- System Health Monitor ------------------------------------------------
# Alerts the first OWNER when CPU load, RAM, disk, or thermal thresholds cross
MONITOR_ENABLED=off
MONITOR_INTERVAL=60s
MONITOR_MEM_PCT=15
MONITOR_DISK_PCT=10
MONITOR_LOAD_MULT=2.0
MONITOR_TEMP_C=75.0
MONITOR_COOLDOWN=30m

# ---- LAN Presence (who's-home tracker) -----------------------------------
# URL of the wifi-presence service (github.com/sirajju/wifi-presence).
# Leave blank to use the default localhost port.
PRESENCE_API_URL=http://127.0.0.1:8765
# Set to "on" to DM the first OWNER on arrival/departure/new-device events.
PRESENCE_ALERTS=off

# ---- Wall-Phone Intercom Bridge -------------------------------------------
# WhatsApp voice note from owner → MQTT → wall-phone speaker playback.
# Wall-phone kiosk mic (/mic page) → POST /voice-from-home → WhatsApp voice note to owner.
INTERCOM_ENABLED=off
INTERCOM_MQTT_BROKER=tcp://127.0.0.1:1883
INTERCOM_MQTT_USER=
INTERCOM_MQTT_PASSWORD=
INTERCOM_MQTT_TOPIC=intercom/play
INTERCOM_HTTP_LISTEN=0.0.0.0:8766
INTERCOM_PUBLIC_URL=
INTERCOM_CACHE_DIR=/tmp/wabot-intercom
# Optional TLS cert & key to enable HTTPS on the intercom server (needed for WebRTC/MediaRecorder in some browsers)
INTERCOM_TLS_CERT=
INTERCOM_TLS_KEY=

# ---- CCTV & Camera -------------------------------------------------------
# IP Webcam HTTP snapshot endpoint
CCTV_URL=
CCTV_USER=
CCTV_PASSWORD=
CCTV_TIMEOUT=15s
# Optional MQTT topic to wake up IP Webcam before capture and put it to sleep after
CCTV_CONTROL_TOPIC=
CCTV_START_TIMEOUT=20s
CCTV_AUTO_STOP=on
# Live stream MJPEG endpoint (default: CCTV_URL with /shot.jpg swapped for /video)
CCTV_STREAM_URL=
CCTV_STREAM_URL_EXT=
CCTV_LIVE_DEFAULT=120s
CCTV_LIVE_MAX=600s

# ---- Household Ping ------------------------------------------------------
# Subscribes to MQTT ping topic (e.g. wall-phone HA button) and DMs the first owner
# with an on-demand living room snapshot from the camera
HOUSEHOLD_ENABLED=on
HOUSEHOLD_PING_TOPIC=household/ping
HOUSEHOLD_PING_COOLDOWN=10s

# ---- AI providers (all optional; bot runs with none) -----------------------
# Pick which provider to use via AI_PREFERRED (opencode/ollama/groq/nvidia/openrouter/anthropic/openai/gemini).
# Leave AI_PREFERRED blank to auto-pick in that same priority order based on what's configured.
AI_PREFERRED=

# Local models (no cost)
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Groq — fast, generous free tier (sign up → Groq Cloud)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# NVIDIA NIM — free developer tier
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenRouter — aggregator, free + paid models under one key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Opencode CLI (local; sst/opencode or similar) — install, then set ENABLED=true
# OPENCODE_CMD is the argv prefix as a comma list; the prompt is appended.
OPENCODE_ENABLED=false
OPENCODE_CMD=opencode,run

# ---- ElevenLabs (TTS + voice cloning) -------------------------------------
# Sign up at elevenlabs.io for a key. VOICE_ID is the default voice used by !tts.
# !voice <name> uses voices you clone via !clonevoice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- RESERVED (not wired to wabot yet) -----------------------------------
MONGO_URL=
